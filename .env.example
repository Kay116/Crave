# Enable Places API (New) in Google Cloud, then add an API key here.
# For this client-side MVP, restrict the key to Places API (New) and set a usage quota.
# Before publishing, move this request behind a small server/edge function so the key is not bundled in the app.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Supabase Project Settings → Connect → Mobile Frameworks → Expo React Native
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
